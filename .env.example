NEXT_PUBLIC_SUPABASE_URL="<your_supabase_project_url>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<sb_publishable_... or anon key>"

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://[YOUR-USER]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://[YOUR-USER]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"